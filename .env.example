# ==============================================================================
# Indoor BLE RTLS — Environment Configuration Template (.env.example)
# Copy this file to .env and customize with your local settings.
# Never commit your actual .env file to version control.
# ==============================================================================

# Backend Service Configuration
BLE_BACKEND_HOST=127.0.0.1
BLE_BACKEND_PORT=8000

# Frontend Web Dashboard Configuration
BLE_DASHBOARD_HOST=127.0.0.1
BLE_DASHBOARD_PORT=3000

# Local Storage & Asset Directories
BLE_DATASETS_DIR=./ble-indoor-positioning/datasets
BLE_RAW_DATA_DIR=./ble-indoor-positioning/datasets/raw
BLE_MODELS_DIR=./ble-indoor-positioning/models
BLE_REPORTS_DIR=./ble-indoor-positioning/reports

# ESP32 Provisioning & Hardware Setup
BLE_WIFI_SSID=IndoorPositioning_WiFi
BLE_WIFI_PASSWORD=YourLocalWiFiPasswordHere
BLE_TARGET_TAG_MAC=52:06:26:03:01:DA
BLE_UDP_PORT=5005
