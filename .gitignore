# ======================================================================
# Indoor BLE Positioning System — Comprehensive Git Ignore
# ======================================================================

# Python Bytecode & Cache Files
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
catboost_info/

# Python Virtual Environments
.venv/
venv/
ENV/
env/

# Node.js & Vite Dependencies & Build Outputs
node_modules/
dist/
.figma/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Unity Build Cache & Editor State
Unity_BLE_Simulator/Library/
Unity_BLE_Simulator/Temp/
Unity_BLE_Simulator/Logs/
Unity_BLE_Simulator/UserSettings/
Unity_BLE_Simulator/Build/

# OS Metadata & IDE Temporary Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/

# Database & Runtime State (Dynamic SQLite & Journals)
*.db
*.sqlite
*.sqlite3
*.sqlite3-journal
*.db-journal
*.db-wal
*.db-shm
*.tmp
*.bak

# Synthetic Datasets & Ad-hoc Session Dumps
ble-indoor-positioning/datasets/synthetic_observations.csv
ble-indoor-positioning/datasets/raw/dataset_*.csv
ble-indoor-positioning/datasets/raw/*_info.json
datasets/

# Security & Secrets Handling
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.crt
*.cert
*secret*.json
*credential*.json

# Preserve Critical Models & Canonical Baseline Datasets for Replication
!ble-indoor-positioning/datasets/observations.csv
!ble-indoor-positioning/models/*.joblib
!ble-indoor-positioning/models/*.json
